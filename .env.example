# Copy to .env and edit. Secrets are intentionally left empty.

# --- Required -------------------------------------------------------------
# "oidc" (sign in through your identity provider) or "none" (no login: only
# behind an authenticating reverse proxy, see the README).
AUTH=oidc
# Public HTTPS address of grab, no trailing slash.
BASE_URL=https://grab.example.com

# --- OIDC (required when AUTH=oidc) ---------------------------------------
# Redirect URI to register at the provider: <BASE_URL>/auth/callback
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=grab
OIDC_CLIENT_SECRET=
# Group allowed to sign in. "*" = anyone the provider authenticates.
OIDC_ALLOWED_GROUP=grab-users
# Group whose members are admins.
OIDC_ADMIN_GROUP=grab-admins
# Scopes requested (default shown).
#OIDC_SCOPES=openid profile email groups

# --- Paths and services (defaults shown) ----------------------------------
#LISTEN_ADDR=:8080
#METUBE_URL=http://metube:8081
#SHARES_DIR=/shares
#DATA_DIR=/data
#COOKIES_DIR=/cookies

# --- Notifications --------------------------------------------------------
# AUTH=none only: Apprise URLs for the single built-in user, separated by
# whitespace or commas. With oidc each user sets theirs on the settings page.
#APPRISE_URLS=

# --- Conversion -----------------------------------------------------------
# libx264 (software) or vaapi (needs the render device passed through).
#ENCODER=libx264
#VAAPI_DEVICE=/dev/dri/renderD128

# --- Housekeeping ---------------------------------------------------------
# Path relative to SHARES_DIR; /healthz fails when it is missing (catches an
# unmounted network share). Empty = skip.
#HEALTHCHECK_FILE=
# Delete private downloads older than this many days. Empty or 0 = never.
#DELETE_AFTER_DAYS=

# --- Jellyfin (optional; off unless URL and key are both set) -------------
#JELLYFIN_URL=
#JELLYFIN_API_KEY=
#JELLYFIN_LIBRARY_ID=
